# ==========================================================
# TELEGRAM WEB (browser session — no Telegram API keys needed)
# A browser window opens; log in to Telegram Web and open the signal chat.
# Login is kept in BROWSER_PROFILE_DIR, so you only log in once.
# ==========================================================
TELEGRAM_WEB_URL=https://web.telegram.org/k/
# chrome / msedge use the installed browser; chromium needs `playwright install chromium`
BROWSER_CHANNEL=chrome
BROWSER_PROFILE_DIR=runtime/browser_profile
# Optional: only watch an open chat whose title contains this text (blank = whatever chat is open)
BROWSER_CHAT_TITLE=
BROWSER_POLL_MS=500
# true = also act on messages you send yourself (handy for testing in Saved Messages)
BROWSER_INCLUDE_OUTGOING=false
MAX_SIGNAL_AGE_SEC=60

# ==========================================================
# MT5 TERMINAL / ACCOUNT
# Prefer a terminal already logged in. Password can stay blank if saved in MT5.
# ==========================================================
MT5_TERMINAL_PATH=C:\Program Files\FTMO Global Markets MT5 Terminal\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MAGIC_NUMBER=810026
# DRY_RUN = check orders only; LIVE = place orders
TRADING_MODE=DRY_RUN
DEVIATION_POINTS=30
ENTRY_TOLERANCE_POINTS=20
MAX_POSITIONS_PER_SYMBOL=1

# ==========================================================
# RISK
# With a valid SL: lot size risks this % of current account EQUITY.
# Without SL: fixed fallback lot, indices only (see below).
# ==========================================================
RISK_PER_TRADE_PCT=1.0
MAX_VOLUME_LOTS=100
DAILY_LOSS_LOCK_PCT=3.0

# No-SL fallback lot, per symbol and ONLY for these four indices:
# NAS100, DOW (US30), GERMAN30 (GER40), UK100.
# Any other instrument without an SL is rejected, never traded on a default lot.
# FALLBACK_LOT_DEFAULT is just the value used for an index with no explicit line.
FALLBACK_LOT_DEFAULT=0.1
FALLBACK_LOT_NAS100=0.1
FALLBACK_LOT_DOW=0.1
FALLBACK_LOT_GERMAN30=0.1
FALLBACK_LOT_UK100=0.1

# ==========================================================
# OPEN CODE GO — AI MESSAGE CLASSIFICATION
# AI decides the message type (open / close trade alert / stop loss alert / ignore);
# every AI field is validated against the raw text before anything is executed.
# ==========================================================
AI_CONFIRMATION_ENABLED=true
AI_FAIL_OPEN=false
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=glm-5.3-flash
OPENCODE_REASONING_EFFORT=low
AI_TIMEOUT_SEC=6

# TP handling if multiple targets are in one message: FIRST / LAST / NONE
TP_POLICY=FIRST

DATABASE_PATH=runtime/copytrader.sqlite3
AUDIT_LOG_PATH=runtime/audit.jsonl

# ==========================================================
# SYMBOL MAPPING — YOU OWN THESE VALUES
# Left side canonical key is used by the parser.
# Right side is the EXACT symbol name shown by YOUR MT5 broker.
# Leave an instrument blank to disable trading it.
# Built-in aliases live in symbol_map.py; add more with ALIASES_<KEY>=a,b,c
# ==========================================================

# Indices
MT5_SYMBOL_NAS100=US100
MT5_SYMBOL_DOW=US30
MT5_SYMBOL_GERMAN30=GER40
MT5_SYMBOL_UK100=UK100
MT5_SYMBOL_SPX500=
MT5_SYMBOL_AUS200=
MT5_SYMBOL_JPN225=

# Metals / energy / crypto
MT5_SYMBOL_XAUUSD=
MT5_SYMBOL_XAGUSD=
MT5_SYMBOL_USOIL=
MT5_SYMBOL_UKOIL=
MT5_SYMBOL_BTCUSD=
MT5_SYMBOL_ETHUSD=
MT5_SYMBOL_LTCUSD=
MT5_SYMBOL_BCHUSD=

# 28 common FX pairs. Override if broker has suffix/prefix, e.g. EURUSD.a or m.EURUSD.
MT5_SYMBOL_AUDCAD=
MT5_SYMBOL_AUDCHF=
MT5_SYMBOL_AUDJPY=
MT5_SYMBOL_AUDNZD=
MT5_SYMBOL_AUDUSD=
MT5_SYMBOL_CADCHF=
MT5_SYMBOL_CADJPY=
MT5_SYMBOL_CHFJPY=
MT5_SYMBOL_EURAUD=
MT5_SYMBOL_EURCAD=
MT5_SYMBOL_EURCHF=
MT5_SYMBOL_EURGBP=
MT5_SYMBOL_EURJPY=
MT5_SYMBOL_EURNZD=
MT5_SYMBOL_EURUSD=
MT5_SYMBOL_GBPAUD=
MT5_SYMBOL_GBPCAD=
MT5_SYMBOL_GBPCHF=
MT5_SYMBOL_GBPJPY=
MT5_SYMBOL_GBPNZD=
MT5_SYMBOL_GBPUSD=
MT5_SYMBOL_NZDCAD=
MT5_SYMBOL_NZDCHF=
MT5_SYMBOL_NZDJPY=
MT5_SYMBOL_NZDUSD=
MT5_SYMBOL_USDCAD=
MT5_SYMBOL_USDCHF=
MT5_SYMBOL_USDJPY=
